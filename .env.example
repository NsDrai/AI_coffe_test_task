# ─────────────────────────────────────────────────────────────
#  кварта · переменные окружения
#  Скопируйте файл в .env.local и заполните своими значениями:
#    cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── MySQL ────────────────────────────────────────────────────
# Вариант 1: отдельные параметры (совпадают с docker-compose.yml из репозитория)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=kvarta
MYSQL_PASSWORD=kvarta
MYSQL_DATABASE=kvarta

# Вариант 2: одна строка подключения, имеет приоритет над параметрами выше
# DATABASE_URL=mysql://kvarta:kvarta@127.0.0.1:13306/kvarta

# Для облачных баз с обязательным TLS
# MYSQL_SSL=true

# Создавать таблицу автоматически при первом запросе (удобно в разработке).
# В продакшене можно накатить db/schema.sql заранее и поставить false.
# DB_AUTO_MIGRATE=true

# ── Доступ к API заявок (для бота и менеджера) ────────────────
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# ── Уведомления о новых заявках ──────────────────────────────
# Вариант 1: бот пишет в чат напрямую.
# 1) создайте бота в @BotFather и возьмите токен
# 2) добавьте бота в нужный чат/группу и получите chat_id (например, через @getidsbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Если чат — это тема (topic) в супергруппе, укажите её номер
# TELEGRAM_MESSAGE_THREAD_ID=

# Вариант 2: отдать заявку отдельному проекту бота (POST с телом { event, lead })
# BOT_WEBHOOK_URL=
# BOT_WEBHOOK_SECRET=

# ── Сайт ─────────────────────────────────────────────────────
# Используется в метаданных и canonical-ссылке
NEXT_PUBLIC_SITE_URL=http://localhost:3000
