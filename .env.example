# ─────────────────────────────────────────────────────────────
#  кварта · переменные окружения
#  Скопируйте файл в .env.local и заполните своими значениями:
#    cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────
# Вариант 1 (рекомендуется для прода): одна строка подключения.
# Neon выдаёт её в панели проекта: Connection string → Pooled connection.
# DATABASE_URL=postgresql://kvarta:пароль@ep-xxx-pooler.eu-central-1.aws.neon.tech/kvarta?sslmode=require

# Вариант 2: отдельные параметры (совпадают с docker-compose.yml)
PGHOST=127.0.0.1
PGPORT=15432
PGUSER=kvarta
PGPASSWORD=kvarta
PGDATABASE=kvarta

# TLS для облачных баз включается сам, если хост не локальный.
# POSTGRES_SSL=false  — выключить принудительно
# POSTGRES_SSL=true   — включить принудительно

# Размер пула соединений. В serverless держите небольшим (3 и меньше).
# POSTGRES_POOL_SIZE=3

# Создавать таблицу автоматически при первом запросе (удобно в разработке).
# В продакшене можно накатить db/schema.sql заранее и поставить false.
# DB_AUTO_MIGRATE=true

# ── Доступ к API заявок (для бота и менеджера) ────────────────
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=

# ── Уведомления о новых заявках ──────────────────────────────
# Вариант 1: бот пишет в чат напрямую.
# 1) создайте бота в @BotFather и возьмите токен
# 2) добавьте бота в нужный чат/группу и получите chat_id (например, через @getidsbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Если чат — это тема (topic) в супергруппе, укажите её номер
# TELEGRAM_MESSAGE_THREAD_ID=

# Вариант 2: отдать заявку отдельному проекту бота (POST с телом { event, lead })
# BOT_WEBHOOK_URL=
# BOT_WEBHOOK_SECRET=

# ── Сайт ─────────────────────────────────────────────────────
# Используется в метаданных и canonical-ссылке
NEXT_PUBLIC_SITE_URL=http://localhost:3000
